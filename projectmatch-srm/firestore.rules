rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function shortText(value, limit) { return value is string && value.size() > 0 && value.size() <= limit; }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if owns(userId) && request.resource.data.uid == request.auth.uid;
      allow delete: if owns(userId);
    }
    match /availability/{userId} {
      allow read: if true;
      allow write: if owns(userId) && request.resource.data.year == 2026 && request.resource.data.datedBlocks is list && request.resource.data.datedBlocks.size() <= 1464;
    }
    match /projects/{projectId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && shortText(request.resource.data.title, 80) && shortText(request.resource.data.description, 500);
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId;
      match /messages/{messageId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid && shortText(request.resource.data.body, 500);
        allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }
    match /applications/{applicationId} {
      allow create: if signedIn() && request.resource.data.applicantId == request.auth.uid && shortText(request.resource.data.role, 100);
      allow read: if signedIn() && (resource.data.applicantId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow update, delete: if signedIn() && resource.data.applicantId == request.auth.uid;
    }
    match /conversations/{conversationId} {
      allow read, create, update: if signedIn() && request.auth.uid in request.resource.data.participants;
      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid && shortText(request.resource.data.body, 500);
        allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }
  }
}
