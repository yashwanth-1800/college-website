{
  "functions": {
    "api/recommendation.js": { "maxDuration": 30 },
    "api/notifications.js": { "maxDuration": 30 },
    "api/escalations.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/escalations", "schedule": "0 * * * *" }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://emergency-app-f2850.firebaseapp.com/__/auth/:path*"
    }
  ]
}

